# ============================================
# Konfigurasi Telegram Bot (Instant Alert)
# Isi token & chat id lalu simpan file ini sebagai .env
# Cara dapat token: @BotFather di Telegram
# Cara dapat chat id: @userinfobot / @RawDataBot, atau jalankan:
#   python tools/get_chat_id.py
# ============================================
TELEGRAM_BOT_TOKEN="123456789:AAAA-BBBB-CCCC-DDDD_EEEE"
TELEGRAM_CHAT_ID="123456789"

# ============================================
# Opsi pemindaian (opsional)
# ============================================
# CONCURRENCY=10
# TIMEOUT=25
# RETRIES=2
# DEEP_SCAN_ENABLED=1
# DEEP_SCAN_PAGES=20
# DEEP_SCAN_THREADS=3
